# App

APP_ENV=development

SECRET_KEY=your-secret-key-change-in-production



# Database: лише SQLite. Локально файл у теці backend, у Docker compose підставляє шлях /app/data/social_search.db.

DATABASE_URL=sqlite:///./social_search.db



# Google OAuth

GOOGLE_CLIENT_ID=your-google-client-id

GOOGLE_CLIENT_SECRET=your-google-client-secret

GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback



# YouTube Data API

YOUTUBE_API_KEY=your-youtube-api-key



# Semantic model for embeddings (can be switched for A/B tests)

SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

